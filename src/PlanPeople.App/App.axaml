<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PlanPeople.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <PleasantTheme />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PlanPeople.App/Themes/Colors.axaml" />
        <ResourceInclude Source="avares://PlanPeople.App/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>