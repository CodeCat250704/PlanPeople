<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  
  <!-- 默认颜色 (Light) -->
  <Color x:Key="ThemeBackgroundColor">#F3F3F3</Color>
  <Color x:Key="ThemeSidebarColor">#EAEAEA</Color>
  <Color x:Key="ThemeCardColor">#FFFFFF</Color>
  <Color x:Key="ThemeTextColor">#1A1A1A</Color>
  <Color x:Key="ThemeSubTextColor">#666666</Color>
  <Color x:Key="ThemeBorderColor">#E0E0E0</Color>

  <!-- 供 UI 绑定的动态画刷 -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource ThemeBackgroundColor}" />
  <SolidColorBrush x:Key="AppSidebarBrush" Color="{DynamicResource ThemeSidebarColor}" />
  <SolidColorBrush x:Key="AppCardBrush" Color="{DynamicResource ThemeCardColor}" />
  <SolidColorBrush x:Key="AppTextBrush" Color="{DynamicResource ThemeTextColor}" />
  <SolidColorBrush x:Key="AppSubTextBrush" Color="{DynamicResource ThemeSubTextColor}" />
  <SolidColorBrush x:Key="AppBorderBrush" Color="{DynamicResource ThemeBorderColor}" />

</ResourceDictionary>