<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlanPeople.App.ViewModels"
             xmlns:models="using:PlanPeople.Core.Models"
             x:Class="PlanPeople.App.Views.TodayView"
             x:DataType="vm:TodayViewModel">
  <Grid RowDefinitions="Auto, *" Background="{DynamicResource AppBackgroundBrush}">
    
    <!-- 顶部工具栏 -->
    <Grid Grid.Row="0" RowDefinitions="Auto, Auto" Margin="20,15">
      
      <!-- 第一行：日期与操作 -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto, Auto, Auto">
        <Button Grid.Column="0" Command="{Binding PreviousDayCommand}" Background="Transparent" Width="35" Height="35" CornerRadius="17">
          <Path Data="{StaticResource IconChevronLeft}" Stroke="{DynamicResource AppTextBrush}" StrokeThickness="2" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
        </Button>
        
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding DateTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}"/>
          <Border Background="{DynamicResource AppCardBrush}" CornerRadius="10" Padding="8,2">
            <TextBlock Text="{Binding TotalCount, StringFormat='共 {0} 项'}" FontSize="12" Foreground="{DynamicResource AppSubTextBrush}"/>
          </Border>
        </StackPanel>
        
        <Button Grid.Column="2" Command="{Binding ImportIcsCommand}" Background="{DynamicResource AppCardBrush}" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,10,0" Padding="10,5" CornerRadius="6">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Data="{StaticResource IconImport}" Stroke="{DynamicResource AppTextBrush}" StrokeThickness="2" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
            <TextBlock Text="导入" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        
        <Button Grid.Column="3" Command="{Binding ExportIcsCommand}" Background="{DynamicResource AppCardBrush}" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,10,0" Padding="10,5" CornerRadius="6">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Data="{StaticResource IconExport}" Stroke="{DynamicResource AppTextBrush}" StrokeThickness="2" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
            <TextBlock Text="导出" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        
        <Button Grid.Column="4" Command="{Binding ImportCsvCommand}" Background="{DynamicResource AppCardBrush}" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,10,0" Padding="10,5" CornerRadius="6">
          <TextBlock Text="CSV" VerticalAlignment="Center"/>
        </Button>
        
        <Button Grid.Column="5" Command="{Binding NextDayCommand}" Background="Transparent" Width="35" Height="35" CornerRadius="17" Margin="0,0,15,0">
          <Path Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource AppTextBrush}" StrokeThickness="2" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
        </Button>
        
        <Button Grid.Column="6" Command="{Binding AddEventCommand}" Background="#4CAF50" Foreground="White" Padding="15,5" CornerRadius="6">
          <TextBlock Text="+ 新建" FontWeight="Bold"/>
        </Button>
      </Grid>
      
      <!-- 第二行：搜索与标签 -->
      <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,10,0,0">
        <TextBox x:Name="SearchBox" Grid.Column="0" Watermark="搜索日程标题、地点或描述..." 
                 Text="{Binding SearchText}" 
                 Background="{DynamicResource AppCardBrush}" 
                 Foreground="{DynamicResource AppTextBrush}"
                 BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"
                 Padding="10,8" CornerRadius="4" Margin="0,0,15,0"/>
                 
        <ComboBox Grid.Column="1" ItemsSource="{Binding AllTags}" SelectedItem="{Binding SelectedTag}" 
                  Width="150" Background="{DynamicResource AppCardBrush}" Foreground="{DynamicResource AppTextBrush}"/>
      </Grid>
    </Grid>

    <!-- 日程列表 -->
    <ScrollViewer Grid.Row="1" Margin="20,10">
      <Panel>
        <ItemsControl ItemsSource="{Binding TodayEvents}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:CalendarEvent">
              <Border Background="{DynamicResource AppCardBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Tag="{Binding}">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="编辑日程" Click="EditEventMenuClick" />
                    <MenuItem Header="删除日程" Click="DeleteEventMenuClick" Foreground="#FF5252"/>
                  </ContextMenu>
                </Border.ContextMenu>
                
                <Grid ColumnDefinitions="Auto, *, Auto">
                  <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,15,0">
                    <Border.Styles>
                      <Style Selector="Border"><Setter Property="Background" Value="Transparent"/></Style>
                      <Style Selector="Border[Tag=1]"><Setter Property="Background" Value="#FF9800"/></Style>
                      <Style Selector="Border[Tag=2]"><Setter Property="Background" Value="#F44336"/></Style>
                    </Border.Styles>
                    <Border.Tag><Binding Path="Priority"/></Border.Tag>
                  </Border>

                  <StackPanel Grid.Column="1" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Start, StringFormat='{}{0:HH:mm}'}" Foreground="{DynamicResource AppSubTextBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AppTextBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding Location}" Foreground="{DynamicResource AppSubTextBrush}" FontSize="12" IsVisible="{Binding Location, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      <TextBlock Text="{Binding Description}" Foreground="{DynamicResource AppSubTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#2196F3" CornerRadius="4" Padding="6,2" IsVisible="{Binding Recurrence, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="循环" Foreground="White" FontSize="10"/>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <!-- 空状态提示 -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                    IsVisible="{Binding !TodayEvents.Count}">
          <TextBlock Text="这一天空空如也" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppSubTextBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="点击右上角的“+ 新建”开始规划吧！" FontSize="14" Foreground="{DynamicResource AppSubTextBrush}"/>
        </StackPanel>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>