<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlanPeople.App.ViewModels"
             xmlns:models="using:PlanPeople.Core.Models"
             x:Class="PlanPeople.App.Views.WeekView"
             x:DataType="vm:WeekViewModel">
  <Grid RowDefinitions="Auto, *" Background="{DynamicResource AppBackgroundBrush}">
    
    <!-- 顶部栏 -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="20,15">
      <Button Grid.Column="0" Command="{Binding PreviousWeekCommand}" Background="Transparent" Width="35" Height="35" CornerRadius="17">
        <Path Data="{StaticResource IconChevronLeft}" Stroke="{DynamicResource AppTextBrush}" StrokeThickness="2" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
      </Button>
      
      <TextBlock Grid.Column="1" Text="{Binding WeekTitle}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}"/>
      
      <Button Grid.Column="2" Command="{Binding NextWeekCommand}" Background="Transparent" Width="35" Height="35" CornerRadius="17">
        <Path Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource AppTextBrush}" StrokeThickness="2" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
      </Button>
    </Grid>

    <!-- 7天列表 -->
    <ScrollViewer Grid.Row="1" Margin="20,0">
      <ItemsControl ItemsSource="{Binding Days}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DayGroup">
            <StackPanel Margin="0,0,0,25">
              
              <!-- 日期头 (今天高亮) -->
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                <TextBlock Text="{Binding DateText}" FontSize="16" FontWeight="Bold" Foreground="#4CAF50"/>
                <Border Background="#4CAF50" CornerRadius="4" Padding="6,2" IsVisible="{Binding IsToday}">
                  <TextBlock Text="今天" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Border>
              </StackPanel>
              
              <!-- 当天的日程 -->
              <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:CalendarEvent">
                    <Border Background="{DynamicResource AppCardBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,8" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Tag="{Binding}">
                      
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="编辑日程" Click="EditEventMenuClick" />
                          <MenuItem Header="删除日程" Click="DeleteEventMenuClick" Foreground="#FF5252"/>
                        </ContextMenu>
                      </Border.ContextMenu>

                      <Grid ColumnDefinitions="Auto, *, Auto">
                        <!-- 优先级色条 -->
                        <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,15,0">
                          <Border.Styles>
                            <Style Selector="Border"><Setter Property="Background" Value="Transparent"/></Style>
                            <Style Selector="Border[Tag=1]"><Setter Property="Background" Value="#FF9800"/></Style>
                            <Style Selector="Border[Tag=2]"><Setter Property="Background" Value="#F44336"/></Style>
                          </Border.Styles>
                          <Border.Tag><Binding Path="Priority"/></Border.Tag>
                        </Border>

                        <!-- 时间与标题 -->
                        <StackPanel Grid.Column="1" Spacing="4">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Start, StringFormat='{}{0:HH:mm}'}" Foreground="{DynamicResource AppSubTextBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextBrush}"/>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              
              <!-- 空状态 -->
              <TextBlock Text="暂无日程" Foreground="{DynamicResource AppSubTextBrush}" FontSize="12" 
                         IsVisible="{Binding Events.Count, Converter={x:Static ObjectConverters.IsNull}}" Margin="0,5"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>