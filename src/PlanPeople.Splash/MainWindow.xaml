<Window x:Class="PlanPeople.Splash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlanPeople" Height="300" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Black"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="请稍后" Foreground="White" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="正在准备..." Foreground="Gray" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            
            <!-- 轻量动画 -->
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,20,0,0" Foreground="White" Background="#333333" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>